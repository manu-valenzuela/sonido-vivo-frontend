# Rutas públicas que Nginx dirige a cada microservicio (Guía 18).
# Nginx reemplaza el prefijo por /api/ y reenvía a 127.0.0.1:<puerto>.
VITE_AUTH_API_URL=/api/auth-service
VITE_USUARIOS_API_URL=/api/usuarios-service
VITE_PRODUCTOS_API_URL=/api/productos-service
VITE_VENTAS_API_URL=/api/ventas-service
VITE_BOLETAS_API_URL=/api/boletas-service
VITE_BLOG_API_URL=/api/blog-service
VITE_CONTACTO_API_URL=/api/contacto-service
VITE_REPORTES_API_URL=/api/reportes-service
